# ─── Required ─────────────────────────────────────────────────────────────
# Anthropic API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Optional: who Atlas is consulting for ────────────────────────────────
# Atlas will address you by this name and tailor its dissent accordingly.
ATLAS_OWNER_NAME=

# ─── Optional: where Atlas keeps state on disk ────────────────────────────
# Defaults to ./atlas_state in the current directory.
ATLAS_STATE_DIR=

# ─── Optional: Perplexity for fast first-pass research ────────────────────
# If set, Atlas does a Perplexity Sonar scan before a Claude deep-dive.
# Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# ─── Optional: web_search providers ───────────────────────────────────────
# Atlas tries these in order: Tavily → Brave → Serper → DuckDuckGo (no key).
# Tavily is purpose-built for LLM search and gives the best results.
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ─── Optional: model overrides ────────────────────────────────────────────
ATLAS_CHAT_MODEL=claude-opus-4-7
ATLAS_WORKER_MODEL=claude-sonnet-4-6
ATLAS_ORCHESTRATOR_MODEL=claude-sonnet-4-6

# ─── Optional: conversation length ────────────────────────────────────────
ATLAS_MAX_TURNS=40
